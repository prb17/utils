{
    "MetaData":
    {
        "test_name" : "BST Graph-Algorithm Test",
        "test_type" : "unit"
    },
    "Tests" :
    {
        "testInsertContains": [
            { "values": [10, 5, 15, 2, 5, 13, 22], "present": 13, "absent": 99 },
            { "values": [10, 5, 15, 2, 5, 13, 22], "present": 5, "absent": 8 }
        ],
        "testInorderSorted": [
            { "values": [10, 5, 15, 2, 5, 13, 22], "expected": [2, 5, 5, 10, 13, 15, 22] },
            { "values": [1, 2, 3, 4, 5], "expected": [1, 2, 3, 4, 5] }
        ],
        "testFind": [
            { "values": [10, 5, 15, 2, 13, 22], "present": 22, "absent": 7 }
        ],
        "testValidateTrue": [
            { "values": [10, 5, 15, 2, 5, 13, 22] }
        ],
        "testValidateFalse": [
            {}
        ],
        "testValidateFalseRightSubtree": [
            {}
        ],
        "testValidateFalseLeftSubtree": [
            {}
        ],
        "testRemove": [
            { "values": [10, 5, 15, 2, 13, 22, 1], "remove": 1,  "expected": [2, 5, 10, 13, 15, 22], "expected_contains": false },
            { "values": [10, 5, 15, 2, 13, 22, 1], "remove": 2,  "expected": [1, 5, 10, 13, 15, 22], "expected_contains": false },
            { "values": [10, 5, 15, 2, 13, 22, 1], "remove": 15, "expected": [1, 2, 5, 10, 13, 22], "expected_contains": false },
            { "values": [10, 5, 15, 2, 13, 22, 1], "remove": 10, "expected": [1, 2, 5, 13, 15, 22], "expected_contains": false }
        ],
        "testRemoveMissing": [
            { "values": [10, 5, 15, 2, 13, 22, 1], "absent": 99, "expected": [1, 2, 5, 10, 13, 15, 22] }
        ]
    }
}
