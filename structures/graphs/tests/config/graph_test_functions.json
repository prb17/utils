                    {"id": "A", "value": 1, "edges": [{"id": "B", "weight": 2}, {"id": "C", "weight": 5}]},
                    {"id": "B", "value": 2, "edges": []},
                    {"id": "C", "value": 3, "edges": []}
                ]}
            }
        ],
        "testRemoveEdgeKeepsWeightsAligned": [
            {
                "node_id": "A",
                "remove_idx": 1,
                "expected_edge_ids": ["X", "Z"],
                "expected_weights": [2, 9],
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": [{"id": "X", "weight": 2}, {"id": "Y", "weight": 5}, {"id": "Z", "weight": 9}]},
                    {"id": "X", "value": 2, "edges": []},
                    {"id": "Y", "value": 3, "edges": []},
                    {"id": "Z", "value": 4, "edges": []}
                ]}
            }
        ],
        "testOutOfRangeEdgeAccess": [
            {
                "node_id": "A",
                "oor_idx": 5,
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": [{"id": "X", "weight": 2}]},
                    {"id": "X", "value": 2, "edges": []}
