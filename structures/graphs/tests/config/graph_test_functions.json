                    {"id": "C", "value": 3, "edges": [{"id": "D", "weight": 3}]},
                    {"id": "D", "value": 4, "edges": []},
                    {"id": "E", "value": 5, "edges": [{"id": "F", "weight": 7}]},
                    {"id": "F", "value": 6, "edges": []}
                ]}
            }
        ],
        "testEmptyGraphRenders": [
            {
                "expected_empty": true,
                "graph": { "nodes": [] }
            }
        ],
        "testAdjacencyList": [
            {
                "expected_ids": ["A", "B", "C", "D"],
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": [{"id": "B", "weight": 2}, {"id": "C", "weight": 5}]},
