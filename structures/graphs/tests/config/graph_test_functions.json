{
    "MetaData":
    {
        "test_name" : "Graph Functions Test",
        "test_type" : "unit"
    },
    "Tests" :
    {
        "testNodeCount": [
            {
                "expected_count": 6,
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": [{"id": "B", "weight": 2}, {"id": "C", "weight": 5}]},
                    {"id": "B", "value": 2, "edges": [{"id": "D", "weight": 1}]},
                    {"id": "C", "value": 3, "edges": [{"id": "D", "weight": 3}]},
                    {"id": "D", "value": 4, "edges": []},
                    {"id": "E", "value": 5, "edges": [{"id": "F", "weight": 7}]},
                    {"id": "F", "value": 6, "edges": []}
                ]}
            }
        ],
        "testGetById": [
            {
                "lookup_id": "C",
                "expected_value": 3,
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": [{"id": "B", "weight": 2}]},
                    {"id": "B", "value": 2, "edges": []},
                    {"id": "C", "value": 3, "edges": []}
                ]}
            }
        ],
        "testGetMissingReturnsNull": [
            {
                "lookup_id": "Z",
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": []},
                    {"id": "B", "value": 2, "edges": []}
                ]}
            }
        ],
        "testDuplicateAddRejected": [
            {
                "dup_id": "A",
                "value": 99,
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": []},
                    {"id": "B", "value": 2, "edges": []}
                ]}
            }
        ],
        "testDfsOrder": [
            {
                "start_id": "A",
                "expected_order": ["A", "B", "D", "C"],
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": [{"id": "B", "weight": 2}, {"id": "C", "weight": 5}]},
                    {"id": "B", "value": 2, "edges": [{"id": "D", "weight": 1}]},
                    {"id": "C", "value": 3, "edges": [{"id": "D", "weight": 3}]},
                    {"id": "D", "value": 4, "edges": []}
                ]}
            },
            {
                "start_id": "Q",
                "expected_order": [],
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": []}
                ]}
            }
        ],
        "testBfsOrder": [
            {
                "start_id": "A",
                "expected_order": ["A", "B", "C", "D"],
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": [{"id": "B", "weight": 2}, {"id": "C", "weight": 5}]},
                    {"id": "B", "value": 2, "edges": [{"id": "D", "weight": 1}]},
                    {"id": "C", "value": 3, "edges": [{"id": "D", "weight": 3}]},
                    {"id": "D", "value": 4, "edges": []}
                ]}
            },
            {
                "start_id": "Q",
                "expected_order": [],
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": []}
                ]}
            }
        ],
        "testCycleTermination": [
            {
                "start_id": "A",
                "expected_visited": 3,
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": [{"id": "A", "weight": 1}, {"id": "B", "weight": 1}]},
                    {"id": "B", "value": 2, "edges": [{"id": "C", "weight": 1}]},
                    {"id": "C", "value": 3, "edges": [{"id": "A", "weight": 1}]}
                ]}
            }
        ],
        "testToStringContainsAll": [
            {
                "expected_ids": ["A", "B", "C", "D", "E", "F"],
                "graph": { "nodes": [
                    {"id": "A", "value": 1, "edges": [{"id": "B", "weight": 2}, {"id": "C", "weight": 5}]},
