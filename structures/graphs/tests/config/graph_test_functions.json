                "graph": { "nodes": [
                    {"id": "1", "value": 1, "edges": [{"id": "2", "weight": 1}, {"id": "3", "weight": 1}]},
                    {"id": "2", "value": 2, "edges": [{"id": "4", "weight": 1}, {"id": "5", "weight": 1}]},
                    {"id": "3", "value": 3, "edges": [{"id": "6", "weight": 1}, {"id": "7", "weight": 1}]},
                    {"id": "4", "value": 4, "edges": [{"id": "8", "weight": 1}, {"id": "9", "weight": 1}]},
                    {"id": "5", "value": 5, "edges": []},
                    {"id": "6", "value": 6, "edges": []},
                    {"id": "7", "value": 7, "edges": []},
                    {"id": "8", "value": 8, "edges": []},
                    {"id": "9", "value": 9, "edges": []}
                ]}
